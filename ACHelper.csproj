<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ACHelper</AssemblyName>
    <AssemblyTitle>AC Helper</AssemblyTitle>
    <Product>AC Helper</Product>
    <RootNamespace>LolMatchAssistant</RootNamespace>
    <ApplicationIcon>Assets\ac-helper.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
    <Resource Include="Assets\ac-helper.ico" />
    <Resource Include="Assets\ac-helper.png" />
    <Resource Include="Assets\Ranks\*.png" />
    <EmbeddedResource Include="Assets\Augments.zh-CN.json" LogicalName="ACHelper.Augments.zh-CN.json" WithCulture="false" />
  </ItemGroup>
</Project>
