<Window x:Class="LolMatchAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:LolMatchAssistant"
        Title="AC Helper" Icon="Assets/ac-helper.ico" Width="1200" Height="790" MinWidth="960" MinHeight="620"
        Background="{DynamicResource Paper}" FontFamily="Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="12" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource RailText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionSurface" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                CornerRadius="5">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionSurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CaptionSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="Close"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CaptionSurface" Property="Background" Value="#AA3045"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,12"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Foreground" Value="{DynamicResource RailText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <Border x:Name="ActiveMark" DockPanel.Dock="Left" Width="3" Margin="0,2,9,2" CornerRadius="1.5"/>
                                <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SelectedSurface}"/>
                                <Setter TargetName="ActiveMark" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActiveMark" Property="Background" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlainList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <LinearGradientBrush x:Key="HistoryBottomFade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="Transparent" Offset="0"/>
            <GradientStop Color="#32000000" Offset=".36"/>
            <GradientStop Color="Black" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="HistoryFooterAction" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value=".7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value=".55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayerTabContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TabFace" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="6,6,0,0" Padding="8,2,5,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabFace" Property="Background" Value="{DynamicResource HoverSurface}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabFace" Property="Background" Value="{DynamicResource Panel}"/>
                                <Setter TargetName="TabFace" Property="BorderBrush" Value="{DynamicResource SelectionStroke}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabFace" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClosePlayerTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style x:Key="PlayerNameLink" TargetType="Button">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="查看玩家历史战绩"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <TextBlock x:Name="PlayerLinkText" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontWeight="{TemplateBinding FontWeight}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PlayerLinkText" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PlayerLinkText" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanOpenHistory}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AnonymousPlayerName" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanOpenHistory}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SummaryToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SummarySurface" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SummarySurface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SummarySurface" Property="Background" Value="{DynamicResource HoverSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QueuePicker" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="7"
                                                Background="{DynamicResource Panel}"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <DockPanel Margin="10,0,9,0" IsHitTestVisible="False" VerticalAlignment="Center">
                                <TextBlock DockPanel.Dock="Right" Text="▾" Foreground="{DynamicResource Accent}"/>
                                <ContentPresenter x:Name="PickerSelection" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource Ink}"/>
                                <TextBlock x:Name="PickerPlaceholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Muted}" Visibility="Collapsed"/>
                            </DockPanel>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True">
                                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                        CornerRadius="7" Padding="3" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="PickerSelection" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PickerPlaceholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="IconStrip">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="SmallIcon">
            <ContentControl Content="{Binding Portrait}" ContentTemplate="{StaticResource Portrait}" Width="21" Height="21"
                            Margin="0,0,3,0" ToolTip="{Binding Tooltip}" ToolTipService.ShowDuration="12000"/>
        </DataTemplate>
        <DataTemplate x:Key="ReviewBadgeTemplate">
            <Border Padding="6,2" Margin="0,0,4,3" CornerRadius="6"
                    ToolTip="{Binding Reason}" AutomationProperties.HelpText="{Binding Reason}"
                    ToolTipService.ShowDuration="12000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#283C49"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="gold">
                                <Setter Property="Background" Value="#5B4726"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="high">
                                <Setter Property="Background" Value="#294A3E"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="middle">
                                <Setter Property="Background" Value="#344147"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="low">
                                <Setter Property="Background" Value="#4E353C"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="damage">
                                <Setter Property="Background" Value="#733840"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="support">
                                <Setter Property="Background" Value="#285643"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="economy">
                                <Setter Property="Background" Value="#67482F"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="objective">
                                <Setter Property="Background" Value="#5B4829"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="vision">
                                <Setter Property="Background" Value="#304F73"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="control">
                                <Setter Property="Background" Value="#5F4270"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="ping">
                                <Setter Property="Background" Value="#625224"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="participation">
                                <Setter Property="Background" Value="#2B555A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="bottom">
                                <Setter Property="Background" Value="#602B3C"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="mvp">
                                <Setter Property="Background" Value="#6D4C1E"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="svp">
                                <Setter Property="Background" Value="#44457D"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="multikill">
                                <Setter Property="Background" Value="#743458"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="dive">
                                <Setter Property="Background" Value="#765031"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="comeback">
                                <Setter Property="Background" Value="#235D50"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="overflow">
                                <Setter Property="Background" Value="#3B4C55"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Label}" Foreground="#F4F7F8" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>
        <Style x:Key="ReviewTags" TargetType="ItemsControl">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate" Value="{StaticResource ReviewBadgeTemplate}"/>
            <Style.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ScoreMetricBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{DynamicResource Stroke}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ScoreIcon">
            <Border x:Name="IconTile" Width="17" Height="17" Margin="0,0,2,2" CornerRadius="2"
                    Background="Transparent" ToolTip="{Binding Tooltip}" ToolTipService.ShowDuration="12000">
                <ContentControl Content="{Binding Portrait}" ContentTemplate="{StaticResource LoadoutArtwork}"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAugment}" Value="True">
                    <Setter TargetName="IconTile" Property="Background" Value="#222B3C"/>
                    <Setter TargetName="IconTile" Property="BorderBrush" Value="#53627B"/>
                    <Setter TargetName="IconTile" Property="BorderThickness" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="CardRosterEntry">
            <DockPanel Background="Transparent" ToolTip="{Binding Tooltip}" Margin="0,1">
                <ContentControl DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,5,0"
                                Content="{Binding Portrait}" ContentTemplate="{StaticResource Portrait}"/>
                <Grid VerticalAlignment="Center">
                <Button Content="{Binding Title}" Click="OpenPlayerLink" FontSize="11" ToolTip="{Binding Tooltip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PlayerNameLink}">
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsViewed}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding Title}" FontSize="11" Style="{StaticResource AnonymousPlayerName}"/>
                </Grid>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="ScoreEntry">
            <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="8,6" MinHeight="52"
                    ToolTip="{Binding ReviewNote}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" MinWidth="90"/>
                        <ColumnDefinition Width="0.9*" MinWidth="79"/>
                        <ColumnDefinition Width="1.05*" MinWidth="82"/>
                        <ColumnDefinition Width="0.8*" MinWidth="52"/>
                        <ColumnDefinition Width="0.8*" MinWidth="52"/>
                        <ColumnDefinition Width="0.8*" MinWidth="55"/>
                        <ColumnDefinition Width="1.4*" MinWidth="135"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,6,0" VerticalAlignment="Center">
                        <Grid DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,6,0">
                            <ContentControl Content="{Binding Portrait}" ContentTemplate="{StaticResource Portrait}"/>
                            <TextBlock Text="{Binding LevelText}" Background="#C0161D21" Foreground="White" FontSize="10" Padding="2,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <Button Content="{Binding Player}" Click="OpenPlayerLink" Style="{StaticResource PlayerNameLink}" FontSize="12"
                                    ToolTip="{Binding Player, StringFormat=查看 {0} 的战绩}"/>
                            <TextBlock Text="{Binding Player}" Style="{StaticResource AnonymousPlayerName}" FontSize="12"/>
                            <TextBlock Text="{Binding Champion}" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Spells}" ItemTemplate="{StaticResource ScoreIcon}"/>
                        <ItemsControl ItemsSource="{Binding Modifiers}" ItemTemplate="{StaticResource ScoreIcon}" Width="57"
                                      HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0" Background="Transparent"
                                ToolTip="{Binding Radar}" ToolTipService.ShowDuration="20000">
                        <TextBlock Text="{Binding CombatLine}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding KdaLine}" FontSize="10" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Damage, StringFormat={}{0:N0}, TargetNullValue=—}" FontSize="12"/>
                        <ProgressBar Style="{StaticResource ScoreMetricBar}" Value="{Binding DamagePercent, Mode=OneWay}"
                                     Foreground="#D98D78" ToolTip="相对于全场最高输出"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Taken, StringFormat={}{0:N0}, TargetNullValue=—}" FontSize="12"/>
                        <ProgressBar Style="{StaticResource ScoreMetricBar}" Value="{Binding TakenPercent, Mode=OneWay}"
                                     Foreground="#73A9C9" ToolTip="相对于全场最高承伤"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="{Binding Gold, StringFormat={}{0:N0}, TargetNullValue=—}" FontSize="12"/>
                        <TextBlock Text="{Binding GoldPerMinute}" FontSize="10" Style="{StaticResource Hint}"/>
                        <TextBlock Text="{Binding Cs, StringFormat=补刀 {0}}" FontSize="10" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <ItemsControl Grid.Column="6" ItemsSource="{Binding Items}" ItemsPanel="{StaticResource IconStrip}"
                                  ItemTemplate="{StaticResource ScoreIcon}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ScoreTeam">
            <Border Margin="0,0,0,8" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <Border Padding="8,6" CornerRadius="5,5,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource LossSurface}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Won}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WinSurface}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <WrapPanel>
                            <TextBlock Text="{Binding Result}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{DynamicResource LossInk}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Won}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Name}" Margin="6,0,0,0" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding Objectives}" Foreground="{DynamicResource Muted}" Margin="12,0,0,0"/>
                        </WrapPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Players}" ItemTemplate="{StaticResource ScoreEntry}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="MatchCard">
          <StackPanel>
            <Border x:Name="MatchPreviewCard" Margin="0,0,4,8" CornerRadius="12" BorderThickness="1" Padding="12,8" Loaded="LoadMatchCardReview">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource LossSurface}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource LossStroke}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Won}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource WinSurface}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource WinStroke}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <ContentControl Content="{Binding Portrait}" ContentTemplate="{StaticResource Portrait}" Width="54" Height="54"
                                        HorizontalAlignment="Left" ToolTip="{Binding Champion}"/>
                        <TextBlock Text="{Binding Result}" FontWeight="SemiBold" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{DynamicResource LossInk}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Won}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WinInk}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,9,0">
                                <ItemsControl ItemsSource="{Binding Spells}" ItemTemplate="{StaticResource ScoreIcon}"/>
                                <ItemsControl ItemsSource="{Binding PreviewModifiers}" ItemTemplate="{StaticResource ScoreIcon}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="2"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <UniformGrid Columns="3">
                                <StackPanel Background="Transparent" ToolTip="{Binding Radar}" ToolTipService.ShowDuration="20000">
                                    <TextBlock Text="{Binding Kda}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding KdaSummary}" Style="{StaticResource Hint}" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="{Binding DamageShare}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Damage, StringFormat={}{0} 伤害}" Style="{StaticResource Hint}" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Cs, StringFormat={}{0} 补刀}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CsPerMinute}" Style="{StaticResource Hint}" FontSize="11"/>
                                </StackPanel>
                            </UniformGrid>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Items}" ItemsPanel="{StaticResource IconStrip}"
                                      ItemTemplate="{StaticResource SmallIcon}" Margin="0,8,0,0"/>
                        <local:ReviewTagStrip x:Name="CardReviewTags" Tags="{Binding Tags}" BadgeTemplate="{StaticResource ReviewBadgeTemplate}"
                                              ClipToBounds="True" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl x:Name="CardAllies" ItemsSource="{Binding Allies}" ItemTemplate="{StaticResource CardRosterEntry}" Margin="0,0,5,0"
                                      AutomationProperties.Name="己方阵容"/>
                        <ItemsControl x:Name="CardOpponents" Grid.Column="1" ItemsSource="{Binding Opponents}" ItemTemplate="{StaticResource CardRosterEntry}"
                                      AutomationProperties.Name="对方阵容"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Caption}" Foreground="{DynamicResource Muted}"
                               TextTrimming="CharacterEllipsis" Margin="0,8,0,0" VerticalAlignment="Center"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="{Binding DetailLabel}" Click="OpenMatch" MinHeight="28" Padding="8,3"
                            HorizontalAlignment="Right" Margin="0,4,0,0" Background="Transparent"/>
                </Grid>
            </Border>
            <Border Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhen}}" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,6,9">
                <StackPanel>
                    <TextBlock Text="对局总览" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DetailStatus}" Margin="0,0,0,5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DetailStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Margin="9,0,9,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" MinWidth="90"/>
                            <ColumnDefinition Width="0.9*" MinWidth="79"/>
                            <ColumnDefinition Width="1.05*" MinWidth="82"/>
                            <ColumnDefinition Width="0.8*" MinWidth="52"/>
                            <ColumnDefinition Width="0.8*" MinWidth="52"/>
                            <ColumnDefinition Width="0.8*" MinWidth="55"/>
                            <ColumnDefinition Width="1.4*" MinWidth="135"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="玩家" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="技能 / 配置" Foreground="{DynamicResource Muted}" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="击杀 / 参团" Foreground="{DynamicResource Muted}" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="输出" Foreground="{DynamicResource Muted}" FontSize="11"/>
                        <TextBlock Grid.Column="4" Text="承伤" Foreground="{DynamicResource Muted}" FontSize="11"/>
                        <TextBlock Grid.Column="5" Text="经济" Foreground="{DynamicResource Muted}" FontSize="11"/>
                        <TextBlock Grid.Column="6" Text="装备" Foreground="{DynamicResource Muted}" FontSize="11"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Teams}" ItemTemplate="{StaticResource ScoreTeam}"/>
                </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="RosterGrid">
            <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="RecentGame">
            <Border Padding="6,5" CornerRadius="6" Margin="0,0,0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource LossSurface}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Won}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource WinSurface}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <ContentControl DockPanel.Dock="Left" Content="{Binding Portrait}" ContentTemplate="{StaticResource Portrait}"
                                    Width="24" Height="24" Margin="0,0,6,0"/>
                    <StackPanel DockPanel.Dock="Right" Margin="4,0,0,0">
                        <TextBlock Text="{Binding Kda}" FontSize="11" TextAlignment="Right"/>
                        <TextBlock Text="{Binding Result}" Style="{StaticResource Hint}" FontSize="10" TextAlignment="Right"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Mode}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="RecentGameButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="展开这场对局"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PreviewSurface" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PreviewSurface" Property="Opacity" Value=".78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SeatCard">
            <Border Background="{DynamicResource Panel}" BorderThickness="1"
                    CornerRadius="12" Padding="8" MinHeight="84" Margin="0,0,6,6">
              <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource SelectionStroke}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <DockPanel>
                    <ContentControl Content="{Binding Portrait}" ContentTemplate="{StaticResource Portrait}" Width="44" Height="44"
                                    DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top"/>
                    <StackPanel>
                        <Button Content="{Binding Title}" Click="OpenPlayerLink" FontSize="14" Style="{StaticResource PlayerNameLink}"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource AnonymousPlayerName}" FontSize="14"/>
                        <TextBlock Text="{Binding Champion}" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
                <StackPanel Margin="0,7,0,5">
                    <DockPanel LastChildFill="True">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stats.Rank, FallbackValue={x:Null}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <Border DockPanel.Dock="Right" Margin="4,0,0,0" CornerRadius="5" Padding="5,2" VerticalAlignment="Center"
                                Visibility="{Binding Stats.HasResults, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource BlueSurface}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stats.WinBalance}" Value="1">
                                            <Setter Property="Background" Value="{DynamicResource WinSurface}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stats.WinBalance}" Value="-1">
                                            <Setter Property="Background" Value="{DynamicResource LossSurface}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Stats.WinRateLabel}" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BlueInk}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Stats.WinBalance}" Value="1">
                                                <Setter Property="Foreground" Value="{DynamicResource WinInk}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stats.WinBalance}" Value="-1">
                                                <Setter Property="Foreground" Value="{DynamicResource LossInk}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <DockPanel VerticalAlignment="Center" ToolTip="{Binding Stats.Rank.WithPoints}">
                            <Image DockPanel.Dock="Left" Source="{Binding RankIcon}" Width="21" Height="21" Margin="0,0,4,0">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <Trigger Property="Source" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="{Binding Stats.Rank.WithPoints}" Foreground="{DynamicResource Ink}" FontSize="11"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DockPanel>
                    <StackPanel Margin="0,4,0,1"
                                Visibility="{Binding Stats.HasResults, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold">
                                <Run Text="{Binding Stats.Wins, Mode=OneWay, StringFormat={}{0} 胜}" Foreground="{DynamicResource WinInk}"/>
                                <Run Text="{Binding Stats.Losses, Mode=OneWay, StringFormat={} {0} 负}" Foreground="{DynamicResource LossInk}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Stats.SampleSize, StringFormat={}近 {0} 场}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ScoreMetricBar}" Value="{Binding Stats.WinPercent, Mode=OneWay}"
                                     Foreground="{DynamicResource WinInk}" Background="{DynamicResource LossStroke}"
                                     IsHitTestVisible="False" Focusable="False"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,3,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Summary}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Tags}" Style="{StaticResource ReviewTags}"/>
                <ItemsControl ItemsSource="{Binding Games}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" ContentTemplate="{StaticResource RecentGame}" Style="{StaticResource RecentGameButton}"
                                    Click="OpenPreviewGame" CommandParameter="{Binding DataContext.LookupPlayer, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Background="{DynamicResource Paper}">
        <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="{DynamicResource Rail}" Height="52"
                Padding="16,0,6,0" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource CaptionButton}"
                            Click="MinimizeMainWindow" ToolTip="最小化" AutomationProperties.Name="最小化窗口"/>
                    <Button x:Name="MaximizeButton" Click="ToggleMainWindowSize">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                <Setter Property="Content" Value="&#xE922;"/>
                                <Setter Property="AutomationProperties.Name" Value="最大化窗口"/>
                                <Setter Property="ToolTip" Value="最大化"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;"/>
                                        <Setter Property="AutomationProperties.Name" Value="还原窗口"/>
                                        <Setter Property="ToolTip" Value="还原"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Tag="Close"
                            Click="CloseMainWindow" ToolTip="关闭" AutomationProperties.Name="关闭窗口"/>
                </StackPanel>
                <ComboBox x:Name="ThemePicker" DockPanel.Dock="Right" Width="117" Height="34" Margin="12,0,0,0"
                          VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                          AutomationProperties.Name="页面风格" ToolTip="页面风格" Style="{StaticResource QueuePicker}"
                          SelectionChanged="PreferenceChanged">
                    <ComboBoxItem Content="跟随系统"/>
                    <ComboBoxItem Content="暗色 · 松绿"/>
                    <ComboBoxItem Content="亮色"/>
                    <ComboBoxItem Content="暗色 · 深蓝"/>
                    <ComboBoxItem Content="亮色 · 青瓷"/>
                    <ComboBoxItem Content="暗色 · 琥珀"/>
                    <ComboBoxItem Content="亮色 · 紫藤"/>
                </ComboBox>
                <Button DockPanel.Dock="Right" Content="选择客户端文件" Click="SelectClient" Margin="12,0,0,0"
                        VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Stroke}"/>
                <Border DockPanel.Dock="Right" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionStatus" Foreground="{DynamicResource Muted}" Text="等待客户端连接"
                               MaxWidth="330" TextTrimming="CharacterEllipsis"/>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/ac-helper.png" Width="24" Height="24" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="AC 助手" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Ac show you more" Foreground="{DynamicResource Muted}" FontSize="12"
                               Margin="13,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl x:Name="Pages" TabStripPlacement="Left">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel KeyboardNavigation.TabNavigation="Local">
                        <Border DockPanel.Dock="Left" Width="108" Background="{DynamicResource Rail}" Padding="0,12,0,0"
                                BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
                            <TabPanel IsItemsHost="True" VerticalAlignment="Top" KeyboardNavigation.TabIndex="0"/>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="20,16"
                                          KeyboardNavigation.TabIndex="1"/>
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem x:Name="HistoryTab" Header="对局战绩">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Margin="0,0,0,10" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasItems, ElementName=HistoryPlayerTabs, Converter={StaticResource VisibleWhen}}">
                        <ListBox x:Name="HistoryPlayerTabs" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlayerTabContainer}"
                                 SelectionChanged="HistoryPageSelected" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                                 AutomationProperties.Name="玩家战绩标签">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Height="28" MaxWidth="210" MinWidth="105" ToolTip="{Binding Tooltip}">
                                        <ContentControl DockPanel.Dock="Left" Width="19" Height="19" Margin="0,0,6,0"
                                                        Content="{Binding Avatar}" ContentTemplate="{StaticResource Portrait}"/>
                                        <Button DockPanel.Dock="Right" Content="×" Click="CloseHistoryPage"
                                                Style="{StaticResource ClosePlayerTab}" ToolTip="关闭标签" AutomationProperties.Name="关闭标签"
                                                Visibility="{Binding CanClose, Converter={StaticResource VisibleWhen}}"/>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="对局战绩" Style="{StaticResource Section}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="HistorySummaryToggle" DockPanel.Dock="Right" Content="统计侧栏" Click="ToggleHistorySummary"
                                      IsChecked="True" Style="{StaticResource SummaryToggle}" ToolTip="显示或收起筛选与统计"/>
                        <Button x:Name="MineButton" DockPanel.Dock="Right" Content="我的战绩" Click="ShowMine" MinHeight="32"/>
                        <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="查询" Click="SearchPlayer" Style="{StaticResource Primary}"/>
                        <Grid Margin="0,0,8,0">
                            <TextBox x:Name="SearchInput" KeyDown="SearchKey" AutomationProperties.Name="游戏名和标签"
                                     ToolTip="输入游戏名#标签，例如 玩家名#1234"/>
                            <TextBlock Text="游戏名#标签" Foreground="{DynamicResource Muted}" Margin="12,0,6,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <Border Grid.Row="2" Margin="0,0,0,12" Padding="12" Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="199"/>
                                <ColumnDefinition Width="199"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <ContentControl x:Name="AccountAvatar" DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Portrait}"
                                                Width="48" Height="48" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="HistoryTitle" Text="近期对局" FontSize="19" FontWeight="SemiBold"
                                                   MaxWidth="258" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <Button x:Name="CopyPlayerIdButton" Content="&#xE8C8;" Click="CopyPlayerId"
                                                Style="{StaticResource HistoryFooterAction}" FontFamily="Segoe MDL2 Assets"
                                                Margin="6,0,0,0" Padding="5,2" MinHeight="24" Width="25"
                                                ToolTip="复制游戏 ID" AutomationProperties.Name="复制完整游戏 ID" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AccountSubtitle" Text="查询玩家后查看排位段位" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Grid.Column="1" Margin="0,0,10,0">
                                <Image x:Name="SoloEmblem" DockPanel.Dock="Left" Width="51" Height="49" Margin="0,0,7,0" Visibility="Collapsed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="单双排位" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="SoloRank" Text="—" Foreground="{DynamicResource Accent}" FontSize="17" FontWeight="SemiBold" Margin="0,3"/>
                                    <TextBlock x:Name="SoloRecord" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <Image x:Name="FlexEmblem" DockPanel.Dock="Left" Width="51" Height="49" Margin="0,0,7,0" Visibility="Collapsed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="灵活排位" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="FlexRank" Text="—" Foreground="{DynamicResource BlueInk}" FontSize="17" FontWeight="SemiBold" Margin="0,3"/>
                                    <TextBlock x:Name="FlexRecord" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HistorySummaryColumn" Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="1" x:Name="HistoryFeed" Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <ListBox x:Name="MatchGrid" Style="{StaticResource PlainList}" Padding="0,0,0,4"
                                         ItemTemplate="{StaticResource MatchCard}" ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.ScrollChanged="HistoryScrollChanged"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         VirtualizingPanel.VirtualizationMode="Standard" KeyDown="OpenMatchKey"/>
                                <Rectangle x:Name="MatchBottomFade" VerticalAlignment="Bottom" Height="22" Margin="0,0,8,0"
                                           Fill="{DynamicResource Paper}" OpacityMask="{StaticResource HistoryBottomFade}"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                            <Border Grid.Row="1" Margin="0,3,4,0" Padding="10,4" MinHeight="40" CornerRadius="8"
                                    Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                                <DockPanel>
                                    <Button x:Name="MoreButton" DockPanel.Dock="Right" Content="加载更早对局" Click="LoadMore"
                                            Background="{DynamicResource SelectedSurface}" Style="{StaticResource HistoryFooterAction}"
                                            IsEnabled="False" Visibility="Collapsed"/>
                                    <Button x:Name="BackToMatchButton" DockPanel.Dock="Left" Content="返回上一场详情" Click="BackToMatch"
                                            Margin="0,0,5,0" Style="{StaticResource HistoryFooterAction}" Visibility="Collapsed"/>
                                    <Button x:Name="BackToRosterButton" DockPanel.Dock="Left" Content="返回当前对局" Click="BackToRoster"
                                            Margin="0,0,5,0" Style="{StaticResource HistoryFooterAction}" Visibility="Collapsed"/>
                                    <TextBlock x:Name="HistoryStatus" Text="登录客户端后可查询战绩。" FontSize="12"
                                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="2,0,8,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <Border x:Name="HistorySummary" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                                BorderThickness="1" CornerRadius="12" Padding="12,12,12,8">
                          <Grid>
                          <ScrollViewer x:Name="HistorySummaryScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="HistoryScrollChanged">
                            <StackPanel Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="对局模式" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="QueueFilter" Height="32" SelectedIndex="0" SelectionChanged="FilterChanged"
                                              Style="{StaticResource QueuePicker}" AutomationProperties.Name="对局模式">
                                        <ComboBoxItem Content="全部模式"/>
                                        <ComboBoxItem Content="排位"/>
                                        <ComboBoxItem Content="匹配"/>
                                        <ComboBoxItem Content="大乱斗"/>
                                    </ComboBox>
                                    <TextBlock Text="近期总览" FontSize="17" FontWeight="SemiBold" Margin="0,15,0,4"/>
                                    <DockPanel Margin="0,4,0,2">
                                        <Grid DockPanel.Dock="Right" Width="54" Height="54" Margin="8,0,0,0">
                                            <Ellipse Width="44" Height="44" StrokeThickness="4" Stroke="{DynamicResource Stroke}"/>
                                            <Path x:Name="RecentRing" Stroke="{DynamicResource Accent}" StrokeThickness="4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <TextBlock x:Name="RecentRate" Text="—" Foreground="{DynamicResource Ink}"
                                                       FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="胜率" Style="{StaticResource Hint}"/>
                                            <TextBlock x:Name="RecentRecord" Foreground="{DynamicResource Ink}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock x:Name="RecentCs" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                                    <ItemsControl x:Name="HistoryMetrics" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Hint}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl x:Name="HistoryTags" Style="{StaticResource ReviewTags}"/>
                                    <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,12,0,12"/>
                                </StackPanel>
                                <TextBlock Text="英雄胜率" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="StatsCaption" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                <ListBox x:Name="StatsList" Style="{StaticResource PlainList}" MaxHeight="192">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,5">
                                                <ContentControl Content="{Binding Portrait}" ContentTemplate="{StaticResource Portrait}"
                                                                DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,7,0"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding RateLabel}" Foreground="{DynamicResource Accent}"
                                                           FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Champion}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,12"/>
                                <DockPanel Margin="0,0,0,5">
                                    <Button x:Name="MasteryToggle" DockPanel.Dock="Right" Content="查看更多" Click="ToggleMastery"
                                            FontSize="11" MinHeight="25" Padding="7,2" Margin="4,0,0,0" Visibility="Collapsed"/>
                                    <TextBlock Text="英雄点数" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="MasteryStatus" Text="查询玩家后查看英雄点数。" Style="{StaticResource Hint}"
                                           FontSize="11" Margin="0,0,0,5"/>
                                <ItemsControl x:Name="MasteryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <ContentControl DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,6,0"
                                                                Content="{Binding Portrait}" ContentTemplate="{StaticResource Portrait}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Points, StringFormat={}{0:N0}}"
                                                           VerticalAlignment="Center" FontWeight="SemiBold" Margin="5,0,0,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Champion}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Level, StringFormat={}{0} 级}" Style="{StaticResource Hint}" FontSize="11"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Margin="0,12,0,4" Visibility="{Binding HasItems, ElementName=TeammatesList, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="最近队友" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="当前筛选内同队" Style="{StaticResource Hint}" FontSize="11" Margin="0,2,0,5"/>
                                    <ItemsControl x:Name="TeammatesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <ContentControl DockPanel.Dock="Left" Content="{Binding Portrait}" ContentTemplate="{StaticResource Portrait}"
                                                                    Width="22" Height="22" Margin="0,0,5,0"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Record}" Style="{StaticResource Hint}"
                                                               FontSize="10" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                    <Button Content="{Binding Title}" Click="OpenPlayerLink" Style="{StaticResource PlayerNameLink}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Margin="0,12,0,4" Visibility="{Binding HasItems, ElementName=EncountersList, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="与你的交手记录" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ItemsControl x:Name="EncountersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,4">
                                                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,2">
                                                        <Run Text="{Binding Relation, Mode=OneWay}"/><Run Text=" · 我的 KDA "/><Run Text="{Binding SelfKda, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <Button DataContext="{Binding Game}" Content="{Binding}" ContentTemplate="{StaticResource RecentGame}"
                                                            Style="{StaticResource RecentGameButton}" Click="OpenPreviewGame"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,12"/>
                                <TextBlock Text="资产" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="AssetList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,3,5,7">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Hint}" FontSize="11"/>
                                                <TextBlock Text="{Binding Value}" FontSize="19" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="AssetStatus" Text="登录后查看账号资产。" Style="{StaticResource Hint}" FontSize="11"/>
                            </StackPanel>
                          </ScrollViewer>
                          <Rectangle x:Name="SummaryBottomFade" VerticalAlignment="Bottom" Height="16" Margin="0,0,8,0"
                                     Fill="{DynamicResource Panel}" OpacityMask="{StaticResource HistoryBottomFade}"
                                     IsHitTestVisible="False" Visibility="Collapsed"/>
                          </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="功能">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="功能" Style="{StaticResource Section}" Margin="0,0,0,16"/>
                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <CheckBox x:Name="AutoAcceptToggle" Content="自动接受对局" Checked="PreferenceChanged" Unchecked="PreferenceChanged" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="18,8,0,0">
                                    <TextBlock Text="接受延迟" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="AcceptDelayPicker" Width="102" Height="32" Style="{StaticResource QueuePicker}"
                                              AutomationProperties.Name="自动接受延迟" SelectionChanged="PreferenceChanged">
                                        <ComboBoxItem Content="立即"/>
                                        <ComboBoxItem Content="1 秒"/>
                                        <ComboBoxItem Content="2 秒"/>
                                        <ComboBoxItem Content="3 秒"/>
                                        <ComboBoxItem Content="4 秒"/>
                                        <ComboBoxItem Content="5 秒"/>
                                    </ComboBox>
                                </StackPanel>
                                <Separator Margin="0,16" Background="{DynamicResource Stroke}"/>
                                <CheckBox x:Name="AutoPickToggle" Content="自动预选英雄" Checked="PreferenceChanged" Unchecked="PreferenceChanged" FontWeight="SemiBold"/>
                                <TextBlock Text="在支持主动选取英雄的模式中预选。你手动选择其他英雄时，以你的选择为准。" Style="{StaticResource Hint}" Margin="18,6,0,10"/>
                                <ComboBox x:Name="ChampionPicker" Height="34" Width="230" HorizontalAlignment="Left" Margin="18,0,0,0"
                                          AutomationProperties.Name="自动预选英雄" Tag="选择英雄" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          TextSearch.TextPath="Name" Style="{StaticResource QueuePicker}" SelectionChanged="PreferenceChanged"/>
                                <CheckBox x:Name="LockInToggle" Content="轮到自己时自动锁定" Checked="PreferenceChanged" Unchecked="PreferenceChanged" Margin="18,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="AutomationStatus" Text="连接客户端后可用" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                CornerRadius="12" Padding="18" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="关于 AC 助手" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                                    <Run Text="GitHub 联系 · "/><Hyperlink NavigateUri="https://github.com/achengz"
                                        Foreground="{DynamicResource Accent}" RequestNavigate="OpenProjectLink">@achengz</Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}">
                                    <Run Text="感谢 Hanxven 与 "/><Hyperlink NavigateUri="https://github.com/LeagueAkari/LeagueAkari"
                                        RequestNavigate="OpenProjectLink" Foreground="{DynamicResource Accent}">League Akari</Hyperlink>
                                    <Run Text=" 贡献者提供选人阶段和对局面板的参考，也感谢 "/><Hyperlink
                                        NavigateUri="https://github.com/CommunityDragon" RequestNavigate="OpenProjectLink"
                                        Foreground="{DynamicResource Accent}">CommunityDragon</Hyperlink><Run Text=" 维护游戏数据。"/>
                                </TextBlock>
                                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}">
                                    <Run Text="AC 助手是独立第三方项目，未获 Riot Games、腾讯或 OP.GG 背书，也不代表其观点。英雄联盟及相关商标和素材归各自权利人所有。软件按现状提供，使用时请遵守适用的游戏与平台规则。"/>
                                </TextBlock>
                                <TextBlock x:Name="ProjectLinkStatus" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="RosterTab" Header="当前对局">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="RosterTitle" Text="当前对局" Style="{StaticResource Section}" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top" x:Name="RosterStatus" Text="进入选人后查看队友，加载或开局后查看双方阵容。" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                    <StackPanel DockPanel.Dock="Top" x:Name="PickTools" Visibility="Collapsed" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="OpRole" Width="105" Height="34" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="OpRoleChanged"
                                      AutomationProperties.Name="OP.GG 分路" Style="{StaticResource QueuePicker}">
                                <ComboBoxItem Content="全部分路"/>
                                <ComboBoxItem Content="上路"/>
                                <ComboBoxItem Content="打野"/>
                                <ComboBoxItem Content="中路"/>
                                <ComboBoxItem Content="下路"/>
                                <ComboBoxItem Content="辅助"/>
                            </ComboBox>
                            <Button Content="OP.GG 分路排行" Click="OpenOpGg"/>
                            <Button x:Name="OpBuildButton" Content="OP.GG 所选英雄" Click="OpenOpGg" IsEnabled="False"/>
                        </StackPanel>
                        <Expander Header="本局符文" Foreground="{DynamicResource Ink}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,10">
                                    <ContentControl x:Name="RunePortrait" Content="{Binding}" ContentTemplate="{StaticResource Portrait}"
                                                    DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="RuneTitle" Text="选人时推荐符文" Style="{StaticResource Section}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="RuneStatus" Grid.Row="1" Text="选中英雄后显示适用的方案。" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                                <ListBox Grid.Row="2" x:Name="RuneList" MaxHeight="170" SelectionChanged="RuneChanged" BorderBrush="{DynamicResource Stroke}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="9,9,6,9">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                                <ItemsControl ItemsSource="{Binding Icons}" ItemsPanel="{StaticResource IconStrip}"
                                                              ItemTemplate="{StaticResource SmallIcon}" Margin="0,7,0,0"/>
                                                <TextBlock Text="{Binding Perks}" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="ApplyButton" Content="应用到客户端" Click="ApplyRune" Style="{StaticResource Primary}" IsEnabled="False"/>
                                    <Button Content="导入符文预设" Click="ImportRunes"/>
                                    <Button Content="导入符文统计" Click="ImportRuneSamples"/>
                                    <Button x:Name="CopyButton" Content="复制所选配置" Click="CopyRune" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel SizeChanged="ResizeRoster">
                            <StackPanel>
                                <Border Background="{DynamicResource BlueSurface}" Padding="12,8" CornerRadius="9" Margin="0,0,0,8">
                                    <TextBlock x:Name="BlueTeamTitle" Text="蓝方" Foreground="{DynamicResource BlueInk}" FontSize="14" FontWeight="SemiBold"/>
                                </Border>
                                <ListBox x:Name="BlueSeats" Tag="4" ItemsPanel="{StaticResource RosterGrid}" ItemTemplate="{StaticResource SeatCard}"
                                         Style="{StaticResource PlainList}" ScrollViewer.VerticalScrollBarVisibility="Disabled" MouseDoubleClick="OpenPlayer" KeyDown="OpenPlayerKey"/>
                            </StackPanel>
                            <StackPanel x:Name="OpponentPanel" Margin="0,12,0,0">
                                <Border Background="{DynamicResource LossSurface}" Padding="12,8" CornerRadius="9" Margin="0,0,0,8">
                                    <TextBlock x:Name="RedTeamTitle" Text="红方" Foreground="{DynamicResource LossInk}" FontSize="14" FontWeight="SemiBold"/>
                                </Border>
                                <ListBox x:Name="RedSeats" Tag="4" ItemsPanel="{StaticResource RosterGrid}" ItemTemplate="{StaticResource SeatCard}"
                                         Style="{StaticResource PlainList}" ScrollViewer.VerticalScrollBarVisibility="Disabled" MouseDoubleClick="OpenPlayer" KeyDown="OpenPlayerKey"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
