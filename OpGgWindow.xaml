<Window x:Class="LolMatchAssistant.OpGgWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OP.GG 攻略" Icon="Assets/ac-helper.ico" Width="650" MinWidth="430" MinHeight="380"
        WindowStartupLocation="Manual" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource Paper}" FontFamily="Microsoft YaHei UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Rail}" Padding="12,6"
                BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="ReloadButton" DockPanel.Dock="Right" Content="刷新" Click="Reload"
                        IsEnabled="False" MinHeight="32" Padding="10,4" Margin="0"/>
                <Button x:Name="ForwardButton" DockPanel.Dock="Right" Content="前进" Click="Forward"
                        IsEnabled="False" MinHeight="32" Padding="10,4"/>
                <Button x:Name="BackButton" DockPanel.Dock="Right" Content="后退" Click="Back"
                        IsEnabled="False" MinHeight="32" Padding="10,4"/>
                <TextBlock x:Name="PageLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="12,7">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=PageStatus}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="PageStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                       Text="正在加载 OP.GG…"/>
        </Border>
        <web:WebView2 x:Name="Browser" ZoomFactor="0.9"/>
    </DockPanel>
</Window>
